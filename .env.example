# Öffentliche Basis-URL (ohne Slash am Ende)
NEXT_PUBLIC_SITE_URL=https://cooler.city

# Supabase (Projekt-URL und öffentlicher Publishable/Anon-Key – beide dürfen in den Browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig: Geheimnis, das die Formular-RPCs in Supabase verlangen
# (muss dem Wert in private.settings 'server_rpc_secret' entsprechen)
SERVER_RPC_SECRET=

# Resend (nur serverseitig)
RESEND_API_KEY=
EMAIL_FROM="Cool City <hello@cooler.city>"
EMAIL_REPLY_TO=hello@cooler.city
# Interne Benachrichtigung über neue Anfragen (leer = keine interne Mail)
INTERNAL_NOTIFY_EMAIL=
# Signatur-Secret des Resend-Webhooks (whsec_…)
RESEND_WEBHOOK_SECRET=

# Vercel Cron schickt "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Optional: datenschutzfreundliche Analytics (z. B. Plausible-Domain), erst nach rechtlicher Prüfung
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Ankündigungsseite mit Passwort: gesetzt = Website nur mit Passwort sichtbar; leer/entfernt = Website öffentlich
SITE_PASSWORD=

# Automatisches Posten neuer Wissen-Beiträge (nur wenn "true" und die Website nicht mehr passwortgeschützt ist)
SOCIAL_AUTOPOST=false
# X API v2, OAuth 1.0a (App mit Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn Posts API (Scope w_organization_social), Token läuft nach ca. 60 Tagen ab
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:
LINKEDIN_API_VERSION=202611
